<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ApplicationId>net.ingen084.kyoshineewviewer</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <!-- AndroidPackageFormat (単数) を指定すると SDK の既定である
             AndroidPackageFormats=aab;apk (Release) が上書きされ片方しか生成されなくなる。
             Debug は SDK の既定で apk のみになる -->
        <RunAOTCompilation>false</RunAOTCompilation>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <PublishReadyToRun>false</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <AndroidResource Include="Icon.png">
            <Link>Resources\drawable\Icon.png</Link>
        </AndroidResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.13" />
    </ItemGroup>

    <!-- プロジェクト参照 -->
    <ItemGroup>
        <!-- Android ヘッドは自己完結ビルドのため、既定では ABI ごとの RuntimeIdentifier が
             参照プロジェクトへも伝播する。本体はマネージドライブラリなので RID 別にビルドする
             必要が無いうえ、RID 別ビルドでは Avalonia の XAML コンパイラが中間アセンブリを
             見つけられず AVLN9999 で失敗する。RID を落として RID 非依存でビルドさせる -->
        <ProjectReference Include="..\KyoshinEewViewer\KyoshinEewViewer.csproj"
            GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    </ItemGroup>
</Project>
