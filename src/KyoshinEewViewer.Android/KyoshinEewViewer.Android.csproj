<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\common.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <!-- 音声再生 (AndroidAudioBackend) が音声フォーカスの要求に AudioFocusRequest を使うため、
             API 26 未満は対象外とする。下げる場合は音声フォーカスの実装も見直しが必要 -->
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>KyoshinEewViewer.Android</RootNamespace>
        <!-- iOS ヘッドと同一の識別子を使う。OAuth のカスタムスキームも
             両ヘッドで共通の DmdataCustomSchemeAuthenticator.RedirectUri を使うため揃えておく -->
        <ApplicationId>net.yumnumm.KyoshinEewViewer</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <!-- パッケージ形式は SDK の既定に任せる (Release は aab と apk の両方、Debug は apk のみ)。
             AndroidPackageFormat (単数) を指定すると AndroidPackageFormats が無視され
             片方しか生成されなくなるため足さないこと -->
        <RunAOTCompilation>false</RunAOTCompilation>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <PublishReadyToRun>false</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <AndroidResource Include="Icon.png">
            <Link>Resources\drawable\Icon.png</Link>
        </AndroidResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.13" />
    </ItemGroup>

    <!-- プロジェクト参照 -->
    <ItemGroup>
        <!-- Android ヘッドは自己完結ビルドのため、既定では ABI ごとの RuntimeIdentifier が
             参照プロジェクトへも伝播する。本体はマネージドライブラリなので RID 別にビルドする
             必要が無いうえ、RID 別ビルドでは Avalonia の XAML コンパイラが中間アセンブリを
             見つけられず AVLN9999 で失敗する。RID を落として RID 非依存でビルドさせる -->
        <ProjectReference Include="..\KyoshinEewViewer\KyoshinEewViewer.csproj"
            GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    </ItemGroup>
</Project>
