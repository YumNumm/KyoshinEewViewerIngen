<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:KyoshinEewViewer.ViewModels"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
			 x:DataType="vm:SettingWindowViewModel" x:CompileBindings="True"
             x:Class="KyoshinEewViewer.Views.SettingPages.DebugMenuPage">
    <ScrollViewer>
        <StackPanel>
            <HeaderedContentControl>
                <HeaderedContentControl.Header>
                    <TextBlock Text="地震情報" FontSize="24" FontFamily="{DynamicResource MainMediumFont}" />
                </HeaderedContentControl.Header>
                <StackPanel Margin="2" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="auto,*,auto">
                        <TextBlock Text="eventID:" Margin="0,0,5,0" />
                        <TextBox Grid.Column="1" Text="{Binding JmaEqdbId}" Margin="0,0,5,0" />
                        <Button Grid.Column="2" Content="取得" Command="{Binding ProcessJmaEqdbRequest}" />
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl>
                <HeaderedContentControl.Header>
                    <TextBlock Text="災危通報" FontSize="24" FontFamily="{DynamicResource MainMediumFont}" />
                </HeaderedContentControl.Header>
                <StackPanel Margin="2" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="auto,*,auto">
                        <TextBlock Text="HEX:" Margin="0,0,5,0" />
                        <TextBox Grid.Column="1" Text="{Binding QzqsmHexString}" Margin="0,0,5,0" AcceptsReturn="True" />
                        <Button Grid.Column="2" Content="送信" Command="{Binding ProcessDCReportRequest}" />
                    </Grid>
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl>
                <HeaderedContentControl.Header>
                    <TextBlock Text="DM-D.S.S（開発者向け）" FontSize="24" FontFamily="{DynamicResource MainMediumFont}" />
                </HeaderedContentControl.Header>
                <StackPanel Margin="2" Spacing="8" HorizontalAlignment="Stretch">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="WebSocket 接続先 URL を ws:// または wss:// で始まる URL に設定すると、認証・Ticket 発行をスキップして直接接続します。空欄でデフォルト動作に戻ります。"/>

                    <TextBlock Text="WebSocket 接続先 URL（直接接続）" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding WebSocketOverrideUrl}"
                             Watermark="ws://localhost:8080 または空欄（デフォルト）"
                             FontSize="12"/>

                    <TextBlock Text="冗長接続エンドポイント（改行区切り）" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding WebSocketRedundantEndpointsText}"
                             Watermark="空欄でデフォルトの冗長エンドポイントを使用"
                             FontSize="12"
                             AcceptsReturn="True"
                             MinHeight="60"/>

                    <TextBlock Text="API ベース URL（空欄でデフォルト: https://api.dmdata.jp）" FontSize="12"/>
                    <TextBox Text="{Binding Config.Dmdata.ApiBaseUrl}"
                             Watermark="https://api.dmdata.jp"
                             FontSize="12"/>

                    <TextBlock Text="データ API ベース URL（空欄でデフォルト: https://data.api.dmdata.jp）" FontSize="12"/>
                    <TextBox Text="{Binding Config.Dmdata.DataApiBaseUrl}"
                             Watermark="https://data.api.dmdata.jp"
                             FontSize="12"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="設定を反映して再接続"
                                Command="{Binding ReconnectDmdataAsync}"
                                IsEnabled="{Binding !IsDmdataReconnecting}"/>
                        <TextBlock Text="{Binding DmdataReconnectStatus}"
                                   VerticalAlignment="Center"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </HeaderedContentControl>

            <Button Content="アプリをクラッシュさせる" FontSize="24" Command="{Binding CrashApp}" HorizontalAlignment="Center">
                <Button.Styles>
                    <Style>
                        <Style.Resources>
                            <SolidColorBrush x:Key="ThemeBorderMidBrush">Red</SolidColorBrush>
                            <SolidColorBrush x:Key="ThemeControlHighBrush">DarkRed</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonBackground">DarkRed</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver">Red</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed">OrangeRed</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonForeground">White</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver">White</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonForegroundPressed">White</SolidColorBrush>
                        </Style.Resources>
                    </Style>
                </Button.Styles>
            </Button>

            <HeaderedContentControl>
                <HeaderedContentControl.Header>
                    <TextBlock Text="パフォーマンス HUD" FontSize="24" FontFamily="{DynamicResource MainMediumFont}" />
                </HeaderedContentControl.Header>
                <StackPanel Margin="2" Spacing="4" HorizontalAlignment="Stretch">
                    <CheckBox Content="メイン画面に地図の描画性能を重ねて表示する"
                              IsChecked="{Binding Config.Debug.ShowPerformanceHud}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource SubForegroundColor}"
                               Text="FPS・描画時間・フレーム間隔・メモリ使用量を右上に表示します。無効の間は計測自体を行いません。" />
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
