<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KyoshinEewViewer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="KyoshinEewViewer.Views.DebugWindow"
        x:DataType="vm:DebugWindowViewModel" x:CompileBindings="True"

        MinWidth="600" MinHeight="400"
        Width="800" Height="600"
        FontSize="14"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource TitleBackgroundColor}"
        Foreground="{DynamicResource MainForegroundColor}"
        FontFamily="{StaticResource MainFont}"
        FontWeight="Regular"
        Icon="/Assets/logo.ico"
        Title="{Binding Title}">

	<TabControl>
		<!-- メトリクスタブ -->
		<TabItem Header="描画処理">
			<Grid RowDefinitions="Auto,10,Auto,10,*">
				<!-- ツールバー -->
				<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
					<Button Content="地図画像を保存" Command="{Binding SaveMapImageAsync}" />
				</StackPanel>

				<!-- ヘッダー情報 -->
				<Border Grid.Row="2"
				        Background="{DynamicResource CardBackgroundColor}"
				        BorderBrush="{DynamicResource BorderColor}"
				        BorderThickness="1"
				        CornerRadius="4"
				        Padding="10">
					<Grid RowDefinitions="Auto,5,Auto,5,Auto,5,Auto,5,Auto" ColumnDefinitions="Auto,10,*">
						<TextBlock Grid.Row="0" Grid.Column="0" Text="更新時刻:" FontWeight="Bold"/>
						<TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Timestamp}"/>

						<TextBlock Grid.Row="4" Grid.Column="0" Text="全体処理時間:" FontWeight="Bold"/>
						<TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding TotalFrameTime}"/>

						<TextBlock Grid.Row="6" Grid.Column="0" Text="ズーム:" FontWeight="Bold"/>
						<TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Zoom}"/>

						<TextBlock Grid.Row="8" Grid.Column="0" Text="ナビゲーション中:" FontWeight="Bold"/>
						<TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding IsNavigating}"/>
					</Grid>
				</Border>

				<!-- レイヤー詳細 -->
				<Border Grid.Row="4"
				        Background="{DynamicResource CardBackgroundColor}"
				        BorderBrush="{DynamicResource BorderColor}"
				        BorderThickness="1"
				        CornerRadius="4">
					<Grid RowDefinitions="Auto,*">
						<TextBlock Grid.Row="0"
						           Text="レイヤー詳細"
						           FontWeight="Bold"
						           FontSize="16"
						           Margin="10,10,10,5"/>

						<ScrollViewer Grid.Row="1">
							<DataGrid ItemsSource="{Binding LayerMetrics}"
							          AutoGenerateColumns="False"
							          IsReadOnly="True"
							          GridLinesVisibility="All"
							          BorderThickness="0"
							          Background="Transparent"
							          CanUserReorderColumns="False"
							          CanUserResizeColumns="True"
							          CanUserSortColumns="False">
								<DataGrid.Columns>
									<DataGridTextColumn Header="レイヤー名" Binding="{Binding LayerName}" Width="*" MinWidth="150"/>
									<DataGridTextColumn Header="処理時間" Binding="{Binding RenderTime}" Width="Auto" MinWidth="100"/>
									<DataGridTextColumn Header="描画情報" Binding="{Binding RenderInfo}" Width="2*" MinWidth="200"/>
								</DataGrid.Columns>
							</DataGrid>
						</ScrollViewer>
					</Grid>
				</Border>
			</Grid>
		</TabItem>

		<!-- ログタブ -->
		<TabItem Header="ログ">
			<Grid RowDefinitions="Auto,10,*">
				<!-- ツールバー -->
				<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
					<Button Content="クリア" Command="{Binding ClearLogs}" />
					<CheckBox Content="自動スクロール" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="10,0,0,0" />
				</StackPanel>

				<!-- ログ表示 -->
				<Border Grid.Row="2"
				        Background="{DynamicResource CardBackgroundColor}"
				        BorderBrush="{DynamicResource BorderColor}"
				        BorderThickness="1"
				        CornerRadius="4">
					<DataGrid x:Name="LogDataGrid"
					          ItemsSource="{Binding LogEntries}"
					          AutoGenerateColumns="False"
					          IsReadOnly="True"
					          GridLinesVisibility="All"
					          BorderThickness="0"
					          Background="Transparent"
					          CanUserReorderColumns="False"
					          CanUserResizeColumns="True"
					          CanUserSortColumns="False">
						<DataGrid.Columns>
							<DataGridTextColumn Header="時刻" Binding="{Binding Timestamp}" Width="Auto" MinWidth="90"/>
							<DataGridTextColumn Header="レベル" Binding="{Binding LogLevel}" Width="Auto" MinWidth="80"/>
							<DataGridTextColumn Header="カテゴリ" Binding="{Binding Category}" Width="Auto" MinWidth="150"/>
							<DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="*" MinWidth="300"/>
						</DataGrid.Columns>
					</DataGrid>
				</Border>
			</Grid>
		</TabItem>

		<!-- 通信タブ -->
		<TabItem Header="通信">
			<Grid RowDefinitions="Auto,10,2*,5,3*">
				<!-- ツールバー -->
				<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
					<CheckBox Content="通信内容を記録する"
					          IsChecked="{Binding RecordNetworkTraffic}"
					          VerticalAlignment="Center" />
					<Button Content="クリア" Command="{Binding ClearNetworkTransactions}" />
					<TextBox Text="{Binding NetworkHostFilter}"
					         PlaceholderText="ホストで絞り込み"
					         Width="200"
					         FontSize="12"
					         VerticalAlignment="Center" />
				</StackPanel>

				<!-- 通信一覧 -->
				<Border Grid.Row="2"
				        Background="{DynamicResource CardBackgroundColor}"
				        BorderBrush="{DynamicResource BorderColor}"
				        BorderThickness="1"
				        CornerRadius="4">
					<DataGrid ItemsSource="{Binding NetworkTransactions}"
					          SelectedItem="{Binding SelectedNetworkTransaction}"
					          AutoGenerateColumns="False"
					          IsReadOnly="True"
					          GridLinesVisibility="All"
					          BorderThickness="0"
					          Background="Transparent"
					          CanUserReorderColumns="False"
					          CanUserResizeColumns="True"
					          CanUserSortColumns="False">
						<DataGrid.Columns>
							<DataGridTextColumn Header="時刻" Binding="{Binding Time}" Width="Auto" MinWidth="90"/>
							<DataGridTextColumn Header="種別" Binding="{Binding Kind}" Width="Auto" MinWidth="50"/>
							<DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="Auto" MinWidth="60"/>
							<DataGridTextColumn Header="ホスト" Binding="{Binding Host}" Width="Auto" MinWidth="150"/>
							<DataGridTextColumn Header="パス" Binding="{Binding Path}" Width="*" MinWidth="200"/>
							<DataGridTextColumn Header="ステータス" Binding="{Binding Status}" Width="Auto" MinWidth="80"/>
							<DataGridTextColumn Header="時間" Binding="{Binding Duration}" Width="Auto" MinWidth="70"/>
							<DataGridTextColumn Header="サイズ" Binding="{Binding Size}" Width="Auto" MinWidth="70"/>
						</DataGrid.Columns>
					</DataGrid>
				</Border>

				<GridSplitter Grid.Row="3"
				              ResizeDirection="Rows"
				              HorizontalAlignment="Stretch"
				              Background="Transparent" />

				<!-- 選択した通信の詳細 -->
				<Border Grid.Row="4"
				        Background="{DynamicResource CardBackgroundColor}"
				        BorderBrush="{DynamicResource BorderColor}"
				        BorderThickness="1"
				        CornerRadius="4">
					<Grid ColumnDefinitions="*,5,*">
						<Grid Grid.Column="0" RowDefinitions="Auto,*">
							<TextBlock Grid.Row="0"
							           Text="リクエスト"
							           FontWeight="Bold"
							           Margin="10,10,10,5"/>
							<ScrollViewer Grid.Row="1">
								<SelectableTextBlock Text="{Binding SelectedNetworkTransaction.RequestDetail}"
								                     FontFamily="Monospace"
								                     FontSize="12"
								                     TextWrapping="Wrap"
								                     Margin="10,0,10,10"/>
							</ScrollViewer>
						</Grid>
						<Grid Grid.Column="2" RowDefinitions="Auto,*">
							<TextBlock Grid.Row="0"
							           Text="レスポンス"
							           FontWeight="Bold"
							           Margin="10,10,10,5"/>
							<ScrollViewer Grid.Row="1">
								<SelectableTextBlock Text="{Binding SelectedNetworkTransaction.ResponseDetail}"
								                     FontFamily="Monospace"
								                     FontSize="12"
								                     TextWrapping="Wrap"
								                     Margin="10,0,10,10"/>
							</ScrollViewer>
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</TabItem>

		<!-- 設定タブ -->
		<TabItem Header="設定">
			<ScrollViewer>
				<StackPanel Margin="10" Spacing="15">
					<!-- 強震モニタ設定 -->
					<Border Background="{DynamicResource CardBackgroundColor}"
					        BorderBrush="{DynamicResource BorderColor}"
					        BorderThickness="1"
					        CornerRadius="4"
					        Padding="15">
						<StackPanel Spacing="10">
							<TextBlock Text="強震モニタ" FontWeight="Bold" FontSize="16"/>
							<CheckBox Content="欠損率が高い場合にレスポンス画像を保存する"
							          IsChecked="{Binding Config.KyoshinMonitor.SaveResponseOnHighMissingRate}"/>
							<TextBlock Text="欠損率が25%以上の場合、レスポンス画像をアプリケーションデータフォルダに保存します。"
							           Foreground="{DynamicResource SubForegroundColor}"
							           TextWrapping="Wrap"
							           FontSize="12"/>
						</StackPanel>
					</Border>

					<!-- DMDATA 接続設定（開発者向け） -->
					<Border Background="{DynamicResource CardBackgroundColor}"
					        BorderBrush="{DynamicResource BorderColor}"
					        BorderThickness="1"
					        CornerRadius="4"
					        Padding="15">
						<StackPanel Spacing="10">
							<TextBlock Text="DM-D.S.S（開発者向け）" FontWeight="Bold" FontSize="16"/>

							<TextBlock TextWrapping="Wrap" FontSize="12"
							           Foreground="{DynamicResource SubForegroundColor}"
							           Text="WebSocket 接続先 URL（単一接続）を ws:// または wss:// で始まる URL に設定すると、認証・Ticket 発行をスキップして直接接続します。空欄にするとデフォルトの論理エンドポイント（Global）を使用します。"/>

							<TextBlock Text="WebSocket 接続先 URL（直接接続）" FontSize="12" FontWeight="SemiBold"/>
							<TextBox Text="{Binding WebSocketOverrideUrl}"
							         Watermark="ws://localhost:8080 または空欄（デフォルト）"
							         FontSize="12"
							         FontFamily="Monospace"/>

							<TextBlock Text="冗長接続エンドポイント（改行区切り）" FontSize="12" FontWeight="SemiBold"/>
							<TextBox Text="{Binding WebSocketRedundantEndpointsText}"
							         Watermark="空欄でデフォルトの冗長エンドポイントを使用"
							         FontSize="12"
							         FontFamily="Monospace"
							         AcceptsReturn="True"
							         MinHeight="60"/>

							<TextBlock TextWrapping="Wrap" FontSize="12"
							           Foreground="{DynamicResource SubForegroundColor}"
							           Text="API ベース URL（空欄でデフォルト: https://api.dmdata.jp）"/>
							<TextBox Text="{Binding Config.Dmdata.ApiBaseUrl}"
							         Watermark="https://api.dmdata.jp"
							         FontSize="12"
							         FontFamily="Monospace"/>

							<TextBlock TextWrapping="Wrap" FontSize="12"
							           Foreground="{DynamicResource SubForegroundColor}"
							           Text="データ API ベース URL（空欄でデフォルト: https://data.api.dmdata.jp）"/>
							<TextBox Text="{Binding Config.Dmdata.DataApiBaseUrl}"
							         Watermark="https://data.api.dmdata.jp"
							         FontSize="12"
							         FontFamily="Monospace"/>

							<StackPanel Orientation="Horizontal" Spacing="10">
								<Button Content="設定を反映して再接続"
								        Command="{Binding ReconnectDmdataAsync}"
								        IsEnabled="{Binding !IsDmdataReconnecting}"/>
								<TextBlock Text="{Binding DmdataReconnectStatus}"
								           VerticalAlignment="Center"
								           FontSize="12"
								           Foreground="{DynamicResource SubForegroundColor}"/>
							</StackPanel>

							<Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,Auto" RowSpacing="4">
								<TextBlock Grid.Row="0" Grid.Column="0" Text="Pong送信遅延:" FontSize="12"/>
								<TextBlock Grid.Row="0" Grid.Column="2" FontSize="12"
								           Text="{Binding DmdataLastPongSendMs, StringFormat='{}{0} ms', TargetNullValue='—'}"/>
								<TextBlock Grid.Row="1" Grid.Column="0" Text="Ping間隔:" FontSize="12"/>
								<TextBlock Grid.Row="1" Grid.Column="2" FontSize="12"
								           Text="{Binding DmdataLastPingIntervalSec, StringFormat='{}{0:0.##} s', TargetNullValue='—'}"/>
							</Grid>

							<TextBlock TextWrapping="Wrap" FontSize="11"
							           Foreground="{DynamicResource SubForegroundColor}"
							           Text="⚠ 誤った URL を設定すると接続が失敗します。設定は config.json に保存されます。"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</TabItem>
	</TabControl>
</Window>
