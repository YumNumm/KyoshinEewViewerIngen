<Project Sdk="Microsoft.NET.Sdk">
	<!-- プラットフォーム依存の通知実装は KyoshinEewViewer.Desktop に切り出したため、本体は単一 TFM でよい -->
	<Import Project="..\..\common.props" />

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- publish / -r 指定時の NETSDK1047 回避（project.assets.json に RID グラフを含める） -->
		<RuntimeIdentifiers>osx-arm64;osx-x64;win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KyoshinEewViewer.Tests" />
	</ItemGroup>

	<!-- EQMonitor API の既定の接続先。値はリポジトリに持たせず、配信ワークフローから
	     環境変数 EQMONITOR_BASE_URL で受け取る。未設定のビルドでは属性自体が付かない -->
	<ItemGroup Condition="'$(EQMONITOR_BASE_URL)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>EqMonitorBaseUrl</_Parameter1>
			<_Parameter2>$(EQMONITOR_BASE_URL)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- プロジェクト参照 -->
	<ItemGroup>
		<ProjectReference Include="..\KyoshinEewViewer.Core\KyoshinEewViewer.Core.csproj" />
		<ProjectReference Include="..\KyoshinEewViewer.DCReportParser\KyoshinEewViewer.DCReportParser.csproj" />
		<ProjectReference Include="..\KyoshinEewViewer.EqMonitorApi\KyoshinEewViewer.EqMonitorApi.csproj" />
		<ProjectReference Include="..\KyoshinEewViewer.JmaXmlParser\KyoshinEewViewer.JmaXmlParser.csproj" />
		<ProjectReference Include="..\KyoshinEewViewer.Map\KyoshinEewViewer.Map.csproj" />
		<ProjectReference Include="..\KyoshinEewViewer.TravelTimeTable\KyoshinEewViewer.TravelTimeTable.csproj" />
		<ProjectReference Include="..\KyoshinEewViewer.CustomControl\KyoshinEewViewer.CustomControl.csproj" />
		<ProjectReference Include="..\KyoshinEewViewer.CodeAnalysis\KyoshinEewViewer.CodeAnalysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
        <PackageReference Include="ManagedBass" Version="4.0.2" />
        <PackageReference Include="MessagePack" Version="3.1.8" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(DotnetVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="$(DotnetVersion)" />
        <PackageReference Include="System.IO.Ports" Version="$(DotnetVersion)" />
        <PackageReference Include="Sentry.Extensions.Logging" Version="6.9.0" />

        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.5" />
        <PackageReference Include="LiveMarkdown.Avalonia" Version="2.3.2" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="System.ServiceModel.Syndication" Version="$(DotnetVersion)" />
        <PackageReference Include="System.Text.Encoding.CodePages" Version="$(DotnetVersion)" />

        <PackageReference Include="Scriban" Version="7.2.6" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="KeyType" />
		<CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="KeyFormat" />
		<CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ValueType" />
		<CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ValueFormat" />
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\AdditionalCommentEarthquake.csv"
			Link="csv\AdditionalCommentEarthquake.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
			ValueFormat="&quot;{1}&quot;" />
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaEpicenter.csv"
			Link="csv\AreaEpicenter.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
			ValueFormat="&quot;{1}&quot;" />
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaInformationPrefectureEarthquake.csv"
			Link="csv\AreaInformationPrefectureEarthquake.csv" KeyType="int" KeyFormat="{0}"
			ValueType="string" ValueFormat="&quot;{1}&quot;" />
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaInformationCity.csv"
			Link="csv\AreaInformationCity.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
			ValueFormat="&quot;{15}&quot;" />
		<!-- 震度観測点コードから細分区域･市町村･観測点名を引く。
		     電文を伴わない受信元では観測点名が得られないため、コードから解決する -->
		<AdditionalFiles
			Include="..\..\jma-code-dictionary\csv\AreaForecastLocalE_AreaInformationCity_PointSeismicIntensity.csv"
			Link="csv\AreaForecastLocalE_AreaInformationCity_PointSeismicIntensity.csv" KeyType="int"
			KeyFormat="{6}"
			ValueType="(int RegionCode, string RegionName, int CityCode, string CityName, string Name)"
			ValueFormat="({0}, &quot;{1}&quot;, {3}, &quot;{4}&quot;, &quot;{7}&quot;)" />
		<!--<AdditionalFiles
		Include="..\..\jma-code-dictionary\csv\AreaEpicenterAbbreviation.csv"
		Link="csv\AreaEpicenterAbbreviation.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
		ValueFormat="&quot;{1}&quot;" />
        <AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaEpicenterDetail.csv"
		Link="csv\AreaEpicenterDetail.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
		ValueFormat="&quot;{1}&quot;" />
        <AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaFloodForecast.csv"
		Link="csv\AreaFloodForecast.csv" KeyType="long" KeyFormat="{0}" ValueType="string"
		ValueFormat="&quot;{1}&quot;" />
        <AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaForecastEEW.csv"
		Link="csv\AreaForecastEEW.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
		ValueFormat="&quot;{1}&quot;" />-->
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaForecastLocalEEW.csv"
			Link="csv\AreaForecastLocalEEW.csv" KeyType="int" KeyFormat="{0}"
			ValueType="(string Name, string NameKana)" ValueFormat="(&quot;{1}&quot;, &quot;{2}&quot;)" />
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaMarineJ.csv"
			Link="csv\AreaMarineJ.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
			ValueFormat="&quot;{1}&quot;" />
		<!--<AdditionalFiles
		Include="..\..\jma-code-dictionary\csv\AreaRiver.csv" Link="csv\AreaRiver.csv" KeyType="long"
		KeyFormat="{0}" ValueType="string" ValueFormat="&quot;{1}&quot;" />
        <AdditionalFiles Include="..\..\jma-code-dictionary\csv\CoastTsunami.csv"
		Link="csv\CoastTsunami.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
		ValueFormat="&quot;{1}&quot;" />-->
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaTsunami.csv"
			Link="csv\AreaTsunami.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
			ValueFormat="&quot;{1}&quot;" />
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\PointVolcano.csv"
			Link="csv\PointVolcano.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
			ValueFormat="&quot;{1}&quot;" />
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\VolcanicWarning.csv"
			Link="csv\VolcanicWarning.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
			ValueFormat="&quot;{1}&quot;" />
		<!--<AdditionalFiles
		Include="..\..\jma-code-dictionary\csv\WaterLevelStation.csv" Link="csv\WaterLevelStation.csv"
		KeyType="long" KeyFormat="{0}" ValueType="(string Name, string Series)"
		ValueFormat="(&quot;{1}&quot;, &quot;{2}&quot;)" />-->
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\MarineWarning.csv"
			Link="csv\MarineWarning.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
			ValueFormat="&quot;{1}&quot;" />
		<AdditionalFiles Include="..\..\jma-code-dictionary\csv\AreaForecastLocalM.csv"
			Link="csv\AreaForecastLocalM.csv" KeyType="int" KeyFormat="{0}" ValueType="string"
			ValueFormat="&quot;{1}&quot;" />
		<AdditionalFiles Include="csv\DCRFloodForecastRegion.csv" Link="csv\DCRFloodForecastRegion.csv"
			KeyType="long" KeyFormat="{0}" ValueType="string" ValueFormat="&quot;{1}&quot;" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Update="Services\Workflows\BuiltinActions\PlaySoundActionControl.axaml.cs">
			<DependentUpon>PlaySoundActionControl.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\SettingPages\WorkflowPage.axaml.cs">
			<DependentUpon>WorkflowPage.axaml</DependentUpon>
		</Compile>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>
