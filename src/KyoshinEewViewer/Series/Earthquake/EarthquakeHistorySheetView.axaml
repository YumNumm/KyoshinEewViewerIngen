<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:controls="clr-namespace:KyoshinEewViewer.CustomControl;assembly=KyoshinEewViewer.CustomControl"
			 xmlns:local="clr-namespace:KyoshinEewViewer.Series.Earthquake;assembly=KyoshinEewViewer"
			 xmlns:models="clr-namespace:KyoshinEewViewer.Series.Earthquake.Models;assembly=KyoshinEewViewer"
			 mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="500"
			 x:Class="KyoshinEewViewer.Series.Earthquake.EarthquakeHistorySheetView"
			 x:DataType="local:EarthquakeSeries"
			 Foreground="{DynamicResource MainForegroundColor}"
			 FontFamily="{StaticResource MainFont}">
    <Panel>
        <ListBox Name="HistoryList" ItemsSource="{Binding Service.Earthquakes}" SelectedItem="{Binding CurrentEvent}"
                 Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.Styles>
                <!-- 行全体をタップ領域にするため、既定のパディングを打ち消す -->
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
                <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Margin" Value="0" />
                </Style>
                <Style Selector="TextBlock.sub">
                    <Setter Property="Foreground" Value="{DynamicResource SubForegroundColor}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="TextBlock.badge">
                    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundColor}" />
                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundColor}" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Padding" Value="2,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:EarthquakeEvent">
                    <Panel>
                        <!-- 震度アイコンは行の高さいっぱいに広げる 幅は 高さ÷IntensityWideScale に合わせている -->
                        <Grid ColumnDefinitions="64,*" Height="48" Background="Transparent">
                            <controls:IntensityIcon Intensity="{Binding Intensity}" WideMode="True"
                                                    VerticalAlignment="Stretch" HorizontalAlignment="Left"
                                                    IsVisible="{Binding !IsVolcano}" />
                            <TextBlock Text="&#xf770;" IsVisible="{Binding IsVolcano}" FontSize="26"
                                       FontFamily="{StaticResource IconFont}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />

                            <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center" Spacing="1">
                                <Grid ColumnDefinitions="auto,*,auto">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Classes="badge" IsVisible="{Binding IsSokuhou}" Text="速報" />
                                        <TextBlock Classes="badge" IsVisible="{Binding IsHypocenterOnly}" Text="震源" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Place}" FontSize="15" Margin="3,0,0,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" IsVisible="{Binding !IsOnlypoint}" Text="など"
                                               FontSize="11" VerticalAlignment="Bottom" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Classes="sub" Text="{Binding Time, StringFormat={}{0:MM/dd HH:mm}, Mode=OneWay}" />
                                        <TextBlock Classes="sub" FontSize="10" VerticalAlignment="Bottom"
                                                   IsVisible="{Binding !IsDetectionTime}" Text="発生" />
                                        <TextBlock Classes="sub" FontSize="10" VerticalAlignment="Bottom"
                                                   IsVisible="{Binding IsDetectionTime}" Text="検知" />
                                    </StackPanel>
                                    <TextBlock Classes="sub" IsVisible="{Binding IsHypocenterAvailable}"
                                               Text="{Binding Magnitude, StringFormat={}M{0:0.0}, Mode=OneWay}" />
                                    <TextBlock Classes="sub" Text="{Binding MagnitudeAlternativeText}"
                                               IsVisible="{Binding MagnitudeAlternativeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <StackPanel Orientation="Horizontal" IsVisible="{Binding !IsNoDepthData}">
                                        <TextBlock Classes="sub" IsVisible="{Binding !IsVeryShallow}"
                                                   Text="{Binding Depth, StringFormat={}深さ{0}km, Mode=OneWay}" />
                                        <TextBlock Classes="sub" IsVisible="{Binding IsVeryShallow}" Text="ごく浅い" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.ColumnSpan="2" IsVisible="{Binding IsTraining}" Text="訓練"
                                       Foreground="{DynamicResource WarningForegroundColor}"
                                       Background="{DynamicResource WarningBackgroundColor}"
                                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.ColumnSpan="2" IsVisible="{Binding IsTest}" Text="試験"
                                       Foreground="{DynamicResource WarningForegroundColor}"
                                       Background="{DynamicResource WarningBackgroundColor}"
                                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                        <Grid Background="#55000000" IsVisible="{Binding IsCancelled}">
                            <TextBlock Text="取り消されました" FontSize="15" FontWeight="Bold" Foreground="White"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                    </Panel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 読み込み中･エラー表示 -->
        <Border IsVisible="{Binding IsLoading}" Background="#AA000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xf252; " Classes="icon" HorizontalAlignment="Center" />
                <TextBlock Text="取得中" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border IsVisible="{Binding IsFault}" Background="#AA000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xf7a9; " Classes="icon" HorizontalAlignment="Center" FontSize="20" Margin="5" />
                <TextBlock Text="情報の取得に問題が発生しました" TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="15" />
                <Button Margin="5" Content="再試行" Command="{Binding Restart}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
