<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:controls="clr-namespace:KyoshinEewViewer.CustomControl;assembly=KyoshinEewViewer.CustomControl"
			 xmlns:conv="clr-namespace:KyoshinEewViewer.Series.Earthquake.Converters;assembly=KyoshinEewViewer"
			 xmlns:local="clr-namespace:KyoshinEewViewer.Series.Earthquake;assembly=KyoshinEewViewer"
			 xmlns:models="clr-namespace:KyoshinEewViewer.Series.Earthquake.Models;assembly=KyoshinEewViewer"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
			 x:Class="KyoshinEewViewer.Series.Earthquake.EarthquakeView"
			 x:DataType="local:EarthquakeSeries"
			 Foreground="{DynamicResource MainForegroundColor}"
			 HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch"
			 FontFamily="{StaticResource MainFont}">
    <UserControl.Resources>
        <conv:IntensityToColorConverter x:Key="IntensityToColor" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.sheetBackdrop">
            <Setter Property="Background" Value="#66000000" />
        </Style>
        <Style Selector="Border.sheet">
            <Setter Property="Background" Value="{DynamicResource DockBackgroundColor}" />
            <Setter Property="CornerRadius" Value="12,12,0,0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BoxShadow" Value="0 -4 24 0 #44000000" />
        </Style>
        <Style Selector="Grid.sheetHeader">
            <Setter Property="Background" Value="{DynamicResource DockTitleBackgroundColor}" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <!-- 広い画面向けレイアウト -->
        <Grid IsVisible="{Binding !IsNarrowLayout}" ColumnDefinitions="240,*,auto">
            <Grid RowDefinitions="auto,*">
                <!-- 選択した地震情報 -->
                <local:EarthquakeSummaryView Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch" />

                <!-- 観測点情報 -->
                <Grid Grid.Row="1" Margin="5,0,5,5" RowDefinitions="auto,*" IsVisible="{Binding ObservationIntensityGroups, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Border Grid.Row="0" Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="4,4,0,0">
                        <StackPanel Orientation="Horizontal" Margin="5,0">
                            <TextBlock Text="各地の震度" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource DockBackgroundColor}" CornerRadius="0,0,4,4" ClipToBounds="True">
                        <local:ObservationIntensityListView />
                    </Border>
                </Grid>
            </Grid>

            <local:EarthquakeOverlayView Grid.Column="1" />

            <!-- 地震情報一覧 -->
            <Grid Grid.Column="2" IsVisible="{Binding IsHistoryShown}" Margin="5" RowDefinitions="auto,*" Width="240" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Border Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="4,4,0,0">
                    <Grid ColumnDefinitions="*,auto" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="過去の地震" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsSearching}" />
                            <TextBlock Text="検索結果" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                                       IsVisible="{Binding IsSearching}" />
                            <TextBlock Text="{Binding DisplayedEarthquakes.Count, StringFormat={}{0}件, Mode=OneWay}" Margin="5,2,0,2"
                                       Foreground="{DynamicResource SubForegroundColor}" FontSize="10"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding SourceString, StringFormat={}取得元: {0}, Mode=OneWay}" Margin="5,2,0,2"
                                       Foreground="{DynamicResource SubForegroundColor}" FontSize="10"
                                       VerticalAlignment="Bottom" IsVisible="{Binding !IsSearching}" />
                        </StackPanel>
                        <Button Grid.Column="1" ToolTip.Tip="検索を解除する" ToolTip.ShowDelay="0"
                                Command="{Binding ClearSearch}" IsVisible="{Binding IsSearching}"
                                Theme="{StaticResource TransparentButton}" Padding="6,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xf00d;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource DockBackgroundColor}" CornerRadius="0,0,4,4" ClipToBounds="True">
                    <ListBox Name="HistoryList" ItemsSource="{Binding DisplayedEarthquakes}" SelectedItem="{Binding CurrentEvent}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="-2" />
                            </Style>
                            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                            <Style Selector="Grid.pointer">
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                            <Style Selector="Grid.pointer>Border.selectBorder">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <ThicknessTransition Property="BorderThickness" Delay="0" Duration="0.2" Easing="QuadraticEaseOut" />
                                    </Transitions>
                                </Setter>
                            </Style>
                            <Style Selector="Grid:pointerover>Border.selectBorder">
                                <Setter Property="BorderThickness" Value="0,0,0,2" />
                            </Style>
                            <Style Selector="Grid>Grid.overlay">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:EarthquakeEvent">
                                <Panel Height="40">
                                    <Grid Classes="pointer" ColumnDefinitions="53,*" Background="Transparent">
                                        <controls:IntensityIcon Intensity="{Binding Intensity}" WideMode="True"
                                                                VerticalAlignment="Top"
                                                                HorizontalAlignment="Left"
                                                                IsVisible="{Binding !IsVolcano}" />
                                        <TextBlock Text="&#xf770;" IsVisible="{Binding IsVolcano}" FontSize="32" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                        <Border Classes="selectBorder" Grid.Column="1"
                                                BorderBrush="{Binding Intensity, Converter={StaticResource IntensityToColor}, ConverterParameter=Background}"
                                                Cursor="Hand">
                                            <Panel>
                                                <Viewbox Stretch="Fill" StretchDirection="DownOnly" Height="24" HorizontalAlignment="Left"
                                                            VerticalAlignment="Bottom" Margin="2,0,45,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Place}" FontSize="18"
                                                                   Margin="0,0,0,-3" />
                                                        <TextBlock IsVisible="{Binding !IsOnlypoint}" Text="など"
                                                                   FontSize="13" Margin="0,0,0,-1"
                                                                   VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </Viewbox>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Height="20" VerticalAlignment="Top">
                                                    <TextBlock IsVisible="{Binding IsSokuhou}" Text="速報" FontSize="10"
                                                                Foreground="{DynamicResource WarningForegroundColor}"
                                                                Background="{DynamicResource WarningBackgroundColor}"
                                                                VerticalAlignment="Center" Margin="2,0" Padding="2,0" />
                                                    <TextBlock IsVisible="{Binding IsHypocenterOnly}"
                                                                Text="震源" FontSize="10"
                                                                Foreground="{DynamicResource WarningForegroundColor}"
                                                                Background="{DynamicResource WarningBackgroundColor}"
                                                                VerticalAlignment="Center" Margin="2,0" Padding="2,0" />
                                                    <TextBlock
                                                        Text="{Binding Time, StringFormat={}{0:MM/dd HH:mm}, Mode=OneWay}"
                                                        Foreground="{DynamicResource SubForegroundColor}"
                                                        FontSize="14" />
                                                    <TextBlock IsVisible="{Binding !IsDetectionTime}" Text="発生" FontSize="10" VerticalAlignment="Bottom" Foreground="{DynamicResource SubForegroundColor}" />
                                                    <TextBlock IsVisible="{Binding IsDetectionTime}" Text="検知" FontSize="10" VerticalAlignment="Bottom" Foreground="{DynamicResource SubForegroundColor}" />
                                                </StackPanel>
                                                <Panel IsVisible="{Binding !IsNoDepthData}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,5,4,0">
                                                    <StackPanel IsVisible="{Binding !IsVeryShallow}"
                                                        Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Margin="0,0,0,-1" Foreground="{DynamicResource SubForegroundColor}"
                                                                    Text="{Binding Depth}" FontSize="12"
                                                                    VerticalAlignment="Bottom" />
                                                        <TextBlock Text="km" FontSize="10" VerticalAlignment="Bottom" Foreground="{DynamicResource SubForegroundColor}" />
                                                    </StackPanel>
                                                    <TextBlock
													    IsVisible="{Binding IsVeryShallow}" Text="ごく浅い"
													    FontSize="10" Margin="0,1,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource SubForegroundColor}" />
                                                </Panel>
                                                <Panel IsVisible="{Binding IsHypocenterAvailable}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,0">
                                                    <StackPanel IsVisible="{Binding MagnitudeAlternativeText, Converter={x:Static StringConverters.IsNullOrEmpty}}" Orientation="Horizontal">
                                                        <TextBlock Text="M" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,-3" Foreground="{DynamicResource SubForegroundColor}" />
                                                        <TextBlock Text="{Binding Magnitude, StringFormat={}{0:0.0}, Mode=OneWay}" FontSize="18" Margin="0,0,0,-4" Foreground="{DynamicResource SubForegroundColor}" />
                                                    </StackPanel>
                                                </Panel>
                                            </Panel>
                                        </Border>
                                        <TextBlock IsVisible="{Binding IsTraining}" Text="訓練" Foreground="{DynamicResource WarningForegroundColor}" Background="{DynamicResource WarningBackgroundColor}"  FontSize="24" FontWeight="Bold" Margin="0,-5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock IsVisible="{Binding IsTest}" Text="試験" Foreground="{DynamicResource WarningForegroundColor}" Background="{DynamicResource WarningBackgroundColor}"  FontSize="24" FontWeight="Bold" Margin="0,-5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                    <Grid Background="#55000000" IsVisible="{Binding IsCancelled}">
                                        <TextBlock Text="取り消されました" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                    <Grid Classes="overlay" Background="#88000000" IsVisible="{Binding IsSelecting}">
                                        <!--<Grid.ContextFlyout>
                                            <ui:FAMenuFlyout ItemsSource="{Binding UsedModels}">
                                                <ui:FAMenuFlyout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ProcessedTelegram">
                                                        <ui:FAMenuFlyoutItem Text="{Binding MenuText}" Command="{ReflectionBinding $parent[UserControl].DataContext.ProcessHistoryXml}" CommandParameter="{Binding Id}" />
                                                    </DataTemplate>
                                                </ui:FAMenuFlyout.ItemTemplate>
                                            </ui:FAMenuFlyout>
                                        </Grid.ContextFlyout>-->
                                        <TextBlock Text="表示中" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Grid>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <!-- 追加読み込み中の表示。一覧に重ねて出す -->
                <Border Grid.Row="1" IsVisible="{Binding EqMonitorService.IsLoadingMore}"
                        Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="0,0,4,4"
                        VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="0,3">
                    <TextBlock Text="過去の地震情報を読み込んでいます…" FontSize="11"
                               Foreground="{DynamicResource SubForegroundColor}" HorizontalAlignment="Center" />
                </Border>

                <!-- 読み込み中･エラー表示 -->
                <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsLoading}" Grid.ColumnSpan="2" Background="#AA000000"
                        CornerRadius="4">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xf252; " Classes="icon" HorizontalAlignment="Center" />
                        <TextBlock Text="取得中" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsFault}" Grid.ColumnSpan="2" Background="#AA000000" CornerRadius="4">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xf7a9; " Classes="icon" HorizontalAlignment="Center" FontSize="20" Margin="5" />
                        <TextBlock Text="情報の取得に問題が発生しました" TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="13" />
                        <Button Margin="5" Content="再試行" Command="{Binding Restart}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 狭い画面向けレイアウト 一覧はシートに移し、地図を広く使う -->
        <Grid IsVisible="{Binding IsNarrowLayout}" RowDefinitions="auto,*">
            <!-- 右上のボタン列と横に並べるため、幅を絞って左上に寄せる -->
            <local:EarthquakeSummaryView Classes="narrow" Width="170" Margin="4,4,0,0"
                                         VerticalAlignment="Top" HorizontalAlignment="Left" />
            <local:EarthquakeOverlayView Grid.Row="1" Classes="narrow" />
        </Grid>

        <!-- 各地の震度のシート -->
        <Panel IsVisible="{Binding IsObservationSheetOpen}">
            <Border Classes="sheetBackdrop" PointerPressed="SheetBackdrop_PointerPressed" />
            <Grid RowDefinitions="2*,5*">
                <Border Grid.Row="1" Classes="sheet">
                    <Grid RowDefinitions="auto,*">
                        <Grid Classes="sheetHeader" ColumnDefinitions="*,auto">
                            <TextBlock Text="各地の震度" FontWeight="Bold" FontSize="16" Margin="10,0" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding CloseSheets}" Theme="{StaticResource TransparentButton}" Padding="12,6">
                                <TextBlock Text="&#xf00d;" Classes="icon" />
                            </Button>
                        </Grid>
                        <local:ObservationIntensityListView Grid.Row="1" Classes="narrow" Margin="8,4,4,4" />
                    </Grid>
                </Border>
            </Grid>
        </Panel>

        <!-- 過去の地震のシート -->
        <Panel IsVisible="{Binding IsHistorySheetOpen}">
            <Border Classes="sheetBackdrop" PointerPressed="SheetBackdrop_PointerPressed" />
            <Grid RowDefinitions="2*,5*">
                <Border Grid.Row="1" Classes="sheet">
                    <Grid RowDefinitions="auto,*">
                        <Grid Classes="sheetHeader" ColumnDefinitions="*,auto,auto,auto">
                            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="過去の地震" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsSearching}" />
                                <TextBlock Text="検索結果" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"
                                           IsVisible="{Binding IsSearching}" />
                                <TextBlock Text="{Binding DisplayedEarthquakes.Count, StringFormat={}{0}件, Mode=OneWay}" Margin="6,0,0,2"
                                           Foreground="{DynamicResource SubForegroundColor}" FontSize="10"
                                           VerticalAlignment="Bottom" />
                                <TextBlock Text="{Binding SourceString, StringFormat={}取得元: {0}, Mode=OneWay}" Margin="6,0,0,2"
                                           Foreground="{DynamicResource SubForegroundColor}" FontSize="10"
                                           VerticalAlignment="Bottom" IsVisible="{Binding !IsSearching}" />
                            </StackPanel>
                            <Button Grid.Column="1" ToolTip.Tip="地震履歴を検索する"
                                    Command="{Binding OpenSearchAsync}" IsVisible="{Binding CanSearch}"
                                    Theme="{StaticResource TransparentButton}" Padding="12,6">
                                <TextBlock Text="&#xf002;" Classes="icon" />
                            </Button>
                            <Button Grid.Column="2" ToolTip.Tip="検索を解除する"
                                    Command="{Binding ClearSearch}" IsVisible="{Binding IsSearching}"
                                    Theme="{StaticResource TransparentButton}" Padding="12,6">
                                <TextBlock Text="&#xf0e2;" Classes="icon" />
                            </Button>
                            <Button Grid.Column="3" Command="{Binding CloseSheets}" Theme="{StaticResource TransparentButton}" Padding="12,6">
                                <TextBlock Text="&#xf00d;" Classes="icon" />
                            </Button>
                        </Grid>
                        <local:EarthquakeHistorySheetView Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>
        </Panel>

        <!-- 震央の範囲を地図で選択中の案内 -->
        <Border IsVisible="{Binding IsSelectingEpicenterRect}" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="{DynamicResource DockTitleBackgroundColor}" CornerRadius="0,0,8,8"
                Padding="14,8" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="震央の範囲にする2点をクリックしてください" VerticalAlignment="Center" />
                <Button Content="キャンセル" Command="{Binding CancelEpicenterRectSelection}" Padding="10,3" />
            </StackPanel>
        </Border>

        <!-- 右上ボタンs 広い画面向け -->
        <StackPanel Orientation="Horizontal" Margin="5" Spacing="5" VerticalAlignment="Top" HorizontalAlignment="Right"
                    IsVisible="{Binding !IsNarrowLayout}">
            <Button ToolTip.Tip="地震履歴を検索する" ToolTip.ShowDelay="0"
				    Command="{Binding OpenSearchAsync}"
				    IsVisible="{Binding CanSearch}">
                <TextBlock Text="&#xf002;" Classes="icon" />
            </Button>
            <Button ToolTip.Tip="時刻表を開く" ToolTip.ShowDelay="0"
				    Command="{Binding OpenTimetableWindow}"
				    IsVisible="{Binding IsDebugBuild}">
                <TextBlock Text="&#xf00b;" Classes="icon" />
            </Button>
            <Button ToolTip.Tip="外部のXMLファイルを開く(動作未保障)" ToolTip.ShowDelay="0"
				    Command="{Binding OpenXml}"
				    IsVisible="{Binding IsDebugBuild}">
                <TextBlock Text="&#xf07c;" Classes="icon" />
            </Button>
            <ToggleButton IsChecked="{Binding IsHistoryShown}"
                          ToolTip.Tip="過去の地震リストを表示する" ToolTip.ShowDelay="0">
                <TextBlock Text="&#xf1da;" Classes="icon" />
            </ToggleButton>
        </StackPanel>

        <!-- 狭い画面向け 情報カードと横に並べられるようメニューへまとめる -->
        <Button Margin="5" Padding="12,7" VerticalAlignment="Top" HorizontalAlignment="Right"
                IsVisible="{Binding IsNarrowLayout}">
            <TextBlock Text="&#xf142;" Classes="icon" />
            <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="各地の震度" ToggleType="CheckBox"
                              IsChecked="{Binding IsObservationSheetOpen, Mode=TwoWay}"
                              IsVisible="{Binding ObservationIntensityGroups, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <MenuItem Header="過去の地震" ToggleType="CheckBox"
                              IsChecked="{Binding IsHistorySheetOpen, Mode=TwoWay}" />
                    <MenuItem Header="地震履歴を検索する" Command="{Binding OpenSearchAsync}"
                              IsVisible="{Binding CanSearch}" />
                    <Separator IsVisible="{Binding IsDebugBuild}" />
                    <MenuItem Header="時刻表を開く" Command="{Binding OpenTimetableWindow}"
                              IsVisible="{Binding IsDebugBuild}" />
                    <MenuItem Header="外部のXMLファイルを開く(動作未保障)" Command="{Binding OpenXml}"
                              IsVisible="{Binding IsDebugBuild}" />
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Panel>
</UserControl>
