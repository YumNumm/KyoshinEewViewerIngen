amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"

// hk util 系ヘルパーは全ファイルを対象にする (see https://hk.jdx.dev/cli/util.html )
local utilFileGlobs = List("**/*")

local workflowGlobs = List(".github/workflows/**/*.yml", ".github/workflows/**/*.yaml")

// composite action の定義ファイル。actionlint は action.yml を workflow として解釈してしまい
// syntax-check で誤検知するため、zizmor / pinact だけ対象に含める。
local actionGlobs = List(".github/actions/**/*.yml", ".github/actions/**/*.yaml")

local workflowAndActionGlobs = workflowGlobs + actionGlobs

local linters = new Mapping<String, Step> {
    ["util-check-merge-conflict"] {
        glob = utilFileGlobs
        check = "mise exec -- hk util check-merge-conflict {{files}}"
    }
    ["util-check-symlinks"] {
        glob = utilFileGlobs
        check = "mise exec -- hk util check-symlinks {{files}}"
    }
    ["util-detect-private-key"] {
        glob = utilFileGlobs
        check = "mise exec -- hk util detect-private-key {{files}}"
    }
    ["gitleaks"] {
        check = "mise exec -- gitleaks git --staged --config .gitleaks.toml"
    }
    ["zizmor"] {
        // --offline でローカルフックから GitHub API を叩かないようにする。
        // 空文字の GITHUB_TOKEN / GH_TOKEN が環境に残っていると zizmor が起動時に落ちるため env -u で外す。
        glob = workflowAndActionGlobs
        check = "mise exec -- env -u GITHUB_TOKEN -u GH_TOKEN zizmor --offline --min-severity low {{files}}"
    }
    ["pinact"] {
        glob = workflowAndActionGlobs
        check = "mise exec -- pinact run --check {{files}}"
    }
    ["actionlint"] {
        glob = workflowGlobs
        check = "mise exec -- actionlint {{files}}"
    }
    ["shellcheck"] {
        glob = List("**/*.sh", "**/*.bash")
        check = "mise exec -- shellcheck -S error {{files}}"
    }
}

hooks {
    ["pre-commit"] {
        fix = false
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
